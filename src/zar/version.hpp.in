// Version information. Generated by CMake from src/zar/version.hpp.in; the
// version itself comes from project() in CMakeLists.txt.
#pragma once

#include <string_view>

namespace zar::version {

inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";
inline constexpr int kMajor = @PROJECT_VERSION_MAJOR@;
inline constexpr int kMinor = @PROJECT_VERSION_MINOR@;
inline constexpr int kPatch = @PROJECT_VERSION_PATCH@;

inline constexpr std::string_view kCopyright = "Copyright (C) 2026 Kevin H. Patterson";

// Recorded at build time (build_info.cpp, from cmake/build_info.cmake).
extern const std::string_view kGitRevision;    // e.g. "3e91c71abcde", "-dirty" if modified
extern const std::string_view kBuildTime;      // UTC; honors SOURCE_DATE_EPOCH

} // namespace zar::version
